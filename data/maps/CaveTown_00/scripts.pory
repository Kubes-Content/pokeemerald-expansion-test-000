mapscripts CaveTown_00_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_0, 0: TownMapLoaded
    ]
}

script CaveTown_00_EventScript_NPC {
    lock
    faceplayer
    bufferleadmonspeciesname(STR_VAR_1)
    msgbox(format("Hey, {PLAYER}! Your {STR_VAR_1} looks pretty strong!"), MSGBOX_DEFAULT)

    # hide NPC next time town is loaded
    setflag(FLAG_UNUSED_0x020)

    release
    end
}

script CaveTown_00_EventScript_Trigger_CaveEntry {
    callnative(SetDynamicWarpForCaveEntry)
    release
    end
}